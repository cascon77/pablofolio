---
import type { Mission } from '../../data/profile';
const { m } = Astro.props as { m: Mission };
---
<article class="box">
  <p class="eyebrow">{m.start} → {m.end}</p>
  <h3 class="font-pixel mt-1 text-xl text-white">{m.role} <span class="text-or">@ {m.company}</span></h3>
  <p class="mt-2">{m.description}</p>
  <ul class="mt-3 list-[square] pl-5 marker:text-or">{m.responsibilities.map((r) => <li>{r}</li>)}</ul>
  <p class="mt-3 flex flex-wrap gap-2">{m.tech.map((t) => <span class="tag">{t}</span>)}</p>
</article>
