---
import type { Project } from '../../data/projects';
import ExtLink from '../ui/ExtLink.astro';
import { withBase } from '../../utils/url';
const { p } = Astro.props as { p: Project };
---
<article class="box flex flex-col">
  {p.image
    ? <img src={withBase(p.image.src)} alt={p.image.alt} loading="lazy" decoding="async" class="border-line mb-4 aspect-video w-full border-2 object-cover" />
    : <div class="border-line text-mute font-pixel mb-4 flex aspect-video items-center justify-center border-2 border-dashed" role="img" aria-label="Captura pendiente">[CAPTURA]</div>}
  <h2 class="font-pixel text-xl text-white">{p.name}</h2>
  <p class="mt-2 grow">{p.description}</p>
  <p class="mt-3 flex flex-wrap gap-2">{p.tech.map((t) => <span class="tag">{t}</span>)}</p>
  <p class="mt-4 flex gap-4 font-mono text-sm">
    {p.github && <ExtLink href={p.github} class="text-or-soft hover:text-or-hi underline underline-offset-4">GitHub</ExtLink>}
    {p.demo && <ExtLink href={p.demo} class="text-or-soft hover:text-or-hi underline underline-offset-4">Demo</ExtLink>}
  </p>
</article>
