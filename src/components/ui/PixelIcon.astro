---
// Iconos 8x8 en SVG inline (sin ficheros ni librerías).
interface Props { name: 'home' | 'user' | 'folder' | 'terminal' | 'lock'; size?: number }
const { name, size = 20 } = Astro.props;
const maps = {
  home: ['...##...', '..####..', '.######.', '########', '.##..##.', '.##..##.', '.##..##.', '.######.'],
  user: ['..####..', '.######.', '.######.', '..####..', '...##...', '.######.', '########', '########'],
  folder: ['###.....', '########', '########', '########', '########', '########', '########', '########'],
  terminal: ['########', '#......#', '#.#....#', '#..#...#', '#.#....#', '#...##.#', '#......#', '########'],
  lock: ['..####..', '.#....#.', '.#....#.', '########', '###..###', '###..###', '########', '########'],
} as const;
const cells = maps[name].flatMap((row, y) => [...row].map((c, x) => (c === '#' ? { x, y } : null)).filter(Boolean)) as { x: number; y: number }[];
---
<svg viewBox="0 0 8 8" width={size} height={size} fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" />)}
</svg>
