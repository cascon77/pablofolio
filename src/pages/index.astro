---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/profile/Avatar.astro';
import ExtLink from '../components/ui/ExtLink.astro';
import { site } from '../config/site';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { withBase } from '../utils/url';
import { getPosts, postUrl, termLabel, termUrl, fmtDate, isoDate } from '../utils/posts';

const logs = (await getPosts('hack')).slice(0, 3);
const featured = projects.filter((p) => p.featured).slice(0, 3);
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.shortName, url: Astro.site?.href, inLanguage: site.lang }];
---
<BaseLayout boot jsonLd={jsonLd}>
  <section class="reveal grid items-center gap-10 md:grid-cols-[1.5fr_1fr]" aria-labelledby="hero">
    <div>
      <p class="eyebrow">PLAYER 1 // PRESS START <span class="cursor" aria-hidden="true">█</span></p>
      <h1 id="hero" class="font-pixel mt-3 text-4xl leading-tight font-bold glitch sm:text-5xl lg:text-6xl">{site.name}</h1>
      <p class="text-or-hi mt-3 font-mono">CLASS: {profile.headline}</p>
      <p class="mt-4 max-w-xl text-lg">{profile.intro}</p>
      <p class="mt-7 flex flex-wrap gap-4">
        <a href={withBase('/profile/')} class="btn btn-fill">▶ CONSULTAR PERFIL</a>
        <a href={withBase('/hack/')} class="btn">HACK BLOG</a>
      </p>
      <p class="mt-6 flex gap-5 font-mono text-sm">
        <ExtLink href={site.github} class="text-or-soft hover:text-or-hi underline underline-offset-4">GitHub</ExtLink>
        <ExtLink href={site.linkedin} class="text-or-soft hover:text-or-hi underline underline-offset-4">LinkedIn</ExtLink>
      </p>
    </div>
    <div>
      <Avatar class="mx-auto max-w-56 md:max-w-none" />
      <p class="mt-3 flex justify-between font-mono text-xs"><span>STATUS: ONLINE</span><span>LVL: {profile.lvl}</span></p>
    </div>
  </section>

  <div class="mt-16 grid gap-8 md:grid-cols-2">
    <section class="box" aria-labelledby="logs">
      <h2 id="logs" class="h-pixel text-2xl">LATEST LOGS</h2>
      {logs.length === 0
        ? <p class="mt-4 font-mono text-sm">$ ls /hack → <span class="text-mute">(sin artículos todavía)</span></p>
        : <ul class="mt-3">{logs.map((p, i) => (
            <li class="border-line flex items-baseline gap-3 border-b border-dashed py-3 last:border-0">
              <span class="text-or font-mono">{String(i + 1).padStart(2, '0')}</span>
              <a href={postUrl('hack', p)} class="grow text-white hover:text-or">{p.data.title}</a>
              <a href={termUrl('hack', 'platform', p.data.platform)} class="tag shrink-0 hover:bg-or hover:text-bg">{termLabel('platform', p.data.platform)}</a>
              <time class="text-mute font-mono text-xs" datetime={isoDate(p.data.date)}>{fmtDate(p.data.date)}</time>
            </li>))}</ul>}
      <p class="mt-4"><a href={withBase('/hack/')} class="text-or-soft hover:text-or-hi font-mono text-sm underline underline-offset-4">Ver todos →</a></p>
    </section>
    <section class="box" aria-labelledby="feat">
      <h2 id="feat" class="h-pixel text-2xl">FEATURED PROJECTS</h2>
      <ul class="mt-3">{featured.map((p, i) => (
        <li class="border-line flex items-baseline gap-3 border-b border-dashed py-3 last:border-0">
          <span class="text-or font-mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="grow text-white">{p.name}</span>
          <span class="tag">{p.tech[0]}</span>
        </li>))}</ul>
      <p class="mt-4"><a href={withBase('/projects/')} class="text-or-soft hover:text-or-hi font-mono text-sm underline underline-offset-4">Ver proyectos →</a></p>
    </section>
  </div>
</BaseLayout>
